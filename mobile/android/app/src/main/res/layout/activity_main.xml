<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Tab bar (visible in both tabs). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tabCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Camera"
            android:textColor="#222222"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabCalib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Calibration"
            android:textColor="#222222"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabGame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Game"
            android:textColor="#222222"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Content area: camera composite OR calibration canvas, plus overlays. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The pipeline draws the composite (face + annotated eye patches) here. -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Eye patch composite" />

        <!-- Active screen-target gaze calibration (shown on the Calibration tab). -->
        <com.raynet.eyepatch.CalibrationView
            android:id="@+id/calibrationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Gaze-driven shape mini-game (shown on the Game tab). -->
        <com.raynet.eyepatch.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Top status / instruction banner. Right padding leaves room for the
             camera-settings gear that floats over its top-right corner. -->
        <TextView
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="52dp"
            android:background="#99000000"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:text="Loading models…" />

        <!-- Camera lens / resolution settings (Camera tab only). -->
        <Button
            android:id="@+id/btnCamera"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="2dp"
            android:padding="0dp"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:contentDescription="Camera settings" />

        <!-- Calibration progress (shown only while calibrating). -->
        <ProgressBar
            android:id="@+id/calibProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="56dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- Bottom controls (Camera tab only). -->
        <LinearLayout
            android:id="@+id/cameraControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#99000000">

            <Button
                android:id="@+id/btnCalibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calibrate" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset" />

            <Button
                android:id="@+id/btnTint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Masks: On" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
